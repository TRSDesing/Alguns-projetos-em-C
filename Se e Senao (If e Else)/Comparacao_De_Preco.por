programa {
  funcao inicio() {

    inteiro preco1 = 76.0 // atribui a variavel
    inteiro preco2 = 77.0

    se (preco1 > preco2) //se preço1 for maior que preço2
      escreva ("Preco1 é maior que preco2") //aparece "Preco1 é maior que preco2"
    senao //senao
      se (preco1 < preco2) //Agora se preço1 é menor que preço2
      escreva ("Preco1 é menor que preco2") //aparece "Preco1 é menor que preco2"
    senao //Senao
      escreva ("Preco1 é igual ao preco2") //Aparece que Preco1 é igual ao preco2

      fimse
    
  }
}

//Não parece muito complicado/ colocar "se" embaixo do "senao"
