programa {
  funcao inicio() {

    inteiro maca = 75.0 //atribuo o valor para as variaveis
    inteiro laranja = 75.0

    se (maca >= laranja) //Se maça for maior ou igual que laranja
      escreva ("Tem mais maça do que laranja!") //Aparece a mensagem "Tem mais maça que laranja!"
    senao //senao, o resultado sera diferente
      escreva ("Tem mais laranja que maça!") //Aparecera a mensagem "Tem mais laranja do que maça!"

      fimse

  }
}

//Prefiro escrever o codigo em ingles pois é mais facil
