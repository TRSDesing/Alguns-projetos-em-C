programa {
  funcao inicio() {
    inteiro idade = 16

    se (idade >= 16) //Se idade for maior ou igual a 16
      escreva ("Você pode votar!") //aparecera a mensagem "Você pode votar!"
    senao //senao
      escreva ("Você não pode votar") //Aparecera a mensagem "Você não pode votar!"

    fimse
    
  }
}
